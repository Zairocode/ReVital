<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC "-//Apache Software Foundation//DTD Struts Configuration 2.3//EN" "http://struts.apache.org/dtds/struts-2.3.dtd">
<struts>
  <constant name="struts.devMode" value="true"/>
  <package name="sirec" extends="struts-default">
    <action name="login"><result>/WEB-INF/jsp/login.jsp</result></action>
    <action name="entrar" class="gt.gob.munisoke.sirec.LoginAction">
      <result name="success">/WEB-INF/jsp/panel.jsp</result>
      <result name="input">/WEB-INF/jsp/login.jsp</result>
    </action>
  </package>
</struts>
